## Miscellaneous ##
exec misc.cfg





setr prism:primaryColor "#2C6EFF"

setr prism:disabledComponents {
    "textUI": false,
    "notify": false,
    "progressBar": false,
    "radial": false,
    "skillCheck": false,
    "inputDialog": false,
    "contextMenu": false,
    "alertDialog": false,
    "listMenu": false
}
setr prism:locale "en"
setr prism:debug 1
setr prism:notificationDuration 3000
setr prism:progressCancelKey "X"
setr prism:notificationPosition "center-right"
setr prism:textUIPosition "left-right"
setr prism:progressBar "primary"
setr prism:radialOpenMode "press"
setr prism:radialOpenKey "f1"
